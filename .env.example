# Copie este arquivo para .env e ajuste se necessário.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cidades_esg
DB_USER=esg_user
DB_PASSWORD=troque_esta_senha
SPRING_PROFILES_ACTIVE=staging

# O pipeline funciona sem secrets usando estes valores acadêmicos locais.
STAGING_DB_NAME=cidades_esg_staging
STAGING_DB_USER=staging_user
STAGING_DB_PASSWORD=staging_password
PROD_DB_NAME=cidades_esg_prod
PROD_DB_USER=prod_user
PROD_DB_PASSWORD=prod_password
